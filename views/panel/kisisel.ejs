<%- include('layout_ust') %>

<div style="margin-bottom:1.5rem;">
    <h1 style="font-size:1.5rem; color:var(--text-primary);" data-tr="Kişisel Bilgiler" data-en="Personal Information">Kişisel Bilgiler</h1>
    <p style="color:var(--text-secondary); font-size:0.9rem;" data-tr="Aday tanıtım sitenizde görünecek temel profil bilgilerinizi güncelleyin." data-en="Update your basic profile info shown on your website.">Aday tanıtım sitenizde görünecek temel profil bilgilerinizi güncelleyin.</p>
</div>

<% if (mesaj) { %>
    <div class="alert alert-success">
        <% if (mesaj === 'bilgiler_guncellendi') { %>
            Kişisel bilgileriniz başarıyla güncellendi.
        <% } else if (mesaj === 'profil_resmi_silindi') { %>
            Profil fotoğrafınız başarıyla kaldırıldı.
        <% } else if (mesaj === 'kapak_resmi_silindi') { %>
            Kapak fotoğrafınız başarıyla kaldırıldı.
        <% } else { %>
            <%= mesaj %>
        <% } %>
    </div>
<% } %>

<% if (hata) { %>
    <div class="alert alert-danger"><%= hata %></div>
<% } %>

<form action="/panel/kisisel-bilgiler" method="POST" enctype="multipart/form-data" class="card">

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.5rem; margin-bottom:1.5rem;">
        <div>
            <label style="font-weight:600; display:block; margin-bottom:0.5rem;" data-tr="Profil Fotoğrafı" data-en="Profile Photo">Profil Fotoğrafı</label>
            <% if (oturumAday.profil_resmi) { %>
                <div style="margin-bottom:0.75rem;">
                    <img src="<%= oturumAday.profil_resmi %>" alt="Profil" style="width:100px; height:100px; border-radius:50%; object-fit:cover; display:block; margin-bottom:0.5rem; border:2px solid var(--ak-sari);">
                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="if(confirm('Profil fotoğrafınızı kaldırmak istediğinize emin misiniz?')) document.getElementById('form-profil-resmi-sil').submit();" data-tr="🗑️ Resim Kaldır" data-en="🗑️ Remove Photo">🗑️ Resim Kaldır</button>
                </div>
            <% } else { %>
                <div style="margin-bottom:0.75rem;">
                    <img src="/images/akparti-official-logo.png" alt="Varsayılan AK Parti Amblemi" style="width:100px; height:100px; border-radius:50%; object-fit:contain; display:block; margin-bottom:0.5rem; border:2px solid var(--border-color); background:#fff; padding:5px;">
                    <small style="color:var(--text-muted); display:block; margin-bottom:0.5rem;">Varsayılan AK Parti amblemi kullanılıyor.</small>
                </div>
            <% } %>
            <input type="file" name="profil_resmi" class="form-control" accept="image/png, image/jpeg, image/jpg, image/webp">
            <small style="color:var(--text-muted); display:block; margin-top:0.25rem;">Format: JPG, PNG, WEBP (Max: 5MB)</small>
        </div>

        <div>
            <label style="font-weight:600; display:block; margin-bottom:0.5rem;" data-tr="Kapak Fotoğrafı" data-en="Cover Photo">Kapak Fotoğrafı</label>
            <% if (oturumAday.kapak_resmi) { %>
                <div style="margin-bottom:0.75rem;">
                    <img src="<%= oturumAday.kapak_resmi %>" alt="Kapak" style="width:100%; height:70px; object-fit:cover; border-radius:var(--radius-md); display:block; margin-bottom:0.5rem;">
                    <button type="button" class="btn btn-outline-danger btn-sm" onclick="if(confirm('Kapak fotoğrafınızı kaldırmak istediğinize emin misiniz?')) document.getElementById('form-kapak-resmi-sil').submit();" data-tr="🗑️ Resim Kaldır" data-en="🗑️ Remove Photo">🗑️ Resim Kaldır</button>
                </div>
            <% } %>
            <input type="file" name="kapak_resmi" class="form-control" accept="image/png, image/jpeg, image/jpg, image/webp">
            <small style="color:var(--text-muted); display:block; margin-top:0.25rem;">Format: JPG, PNG, WEBP (Max: 5MB)</small>
        </div>
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.5rem;">
        <div class="form-group">
            <label data-tr="Ad *" data-en="First Name *">Ad *</label>
            <input type="text" name="ad" class="form-control" value="<%= oturumAday.ad %>" required>
        </div>
        <div class="form-group">
            <label data-tr="Soyad *" data-en="Last Name *">Soyad *</label>
            <input type="text" name="soyad" class="form-control" value="<%= oturumAday.soyad %>" required>
        </div>
    </div>

    <div class="form-group">
        <label data-tr="Adaylık Unvanı" data-en="Candidate Title">Adaylık Unvanı</label>
        <input type="text" name="unvan_tr" class="form-control" value="<%= oturumAday.unvan_tr || '' %>" placeholder="ör. AK Parti Belediye Başkan Adayı">
    </div>

    <div style="display:grid; grid-template-columns:1fr 1fr; gap:1.5rem;">
        <div class="form-group">
            <label data-tr="İl *" data-en="City *">İl *</label>
            <input type="text" name="il" class="form-control" value="<%= oturumAday.il %>" required>
        </div>
        <div class="form-group">
            <label data-tr="İlçe *" data-en="District *">İlçe *</label>
            <input type="text" name="ilce" class="form-control" value="<%= oturumAday.ilce %>" required>
        </div>
    </div>

    <div class="form-group">
        <label data-tr="Kısa Tanıtım Yazısı" data-en="Short Bio">Kısa Tanıtım Yazısı</label>
        <textarea name="kisa_tanitim_tr" class="form-control" rows="3" placeholder="Sitenizin kapak alanında çıkacak kısa slogan veya tanıtım metni..."><%= oturumAday.kisa_tanitim_tr || '' %></textarea>
    </div>

    <button type="submit" class="btn btn-primary" data-tr="Değişiklikleri Kaydet" data-en="Save Changes">Değişiklikleri Kaydet</button>
</form>

<% if (oturumAday.profil_resmi) { %>
    <form id="form-profil-resmi-sil" action="/panel/profil-resmi-sil" method="POST" style="display:none;"></form>
<% } %>

<% if (oturumAday.kapak_resmi) { %>
    <form id="form-kapak-resmi-sil" action="/panel/kapak-resmi-sil" method="POST" style="display:none;"></form>
<% } %>

<%- include('layout_alt') %>
