<%- include('layout_ust') %>

<div style="margin-bottom:1.5rem;">
    <h1 style="font-size:1.5rem; color:var(--text-primary);" data-tr="Haberler ve Duyurular" data-en="News & Announcements">Haberler ve Duyurular</h1>
    <p style="color:var(--text-secondary); font-size:0.9rem;" data-tr="Seçim çalışmaları, ziyaretleriniz ve duyurularınız ile ilgili haberleri paylaşın." data-en="Share news about your campaign events and visits.">Seçim çalışmaları, ziyaretleriniz ve duyurularınız ile ilgili haberleri paylaşın.</p>
</div>

<% if (mesaj) { %>
    <div class="alert alert-success">
        <%= mesaj === 'haber_eklendi' ? 'Yeni haber başarıyla yayınlandı.' :
            mesaj === 'haber_silindi' ? 'Haber silindi.' : mesaj %>
    </div>
<% } %>

<!-- Yeni Haber Ekle Formu -->
<div class="card" style="margin-bottom:2rem;">
    <h3 style="color:var(--ak-kirmizi); margin-bottom:1rem;" data-tr="➕ Yeni Haber Ekle" data-en="➕ Add New News">➕ Yeni Haber Ekle</h3>
    <form action="/panel/haberler/ekle" method="POST" enctype="multipart/form-data">
        <div class="form-group">
            <label data-tr="Haber Başlığı *" data-en="News Title *">Haber Başlığı *</label>
            <input type="text" name="baslik_tr" class="form-control" required placeholder="ör. Esnaf Ziyaretleri Coşkuyla Devam Ediyor">
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:1rem;">
            <div class="form-group">
                <label data-tr="Haber Görseli" data-en="News Image">Haber Görseli</label>
                <input type="file" name="resim" class="form-control" accept="image/png, image/jpeg, image/jpg, image/webp">
            </div>
            <div class="form-group">
                <label data-tr="Tarih" data-en="Date">Tarih</label>
                <input type="text" name="tarih" class="form-control" placeholder="ör. 26 Ağustos 2026">
            </div>
        </div>

        <div class="form-group">
            <label data-tr="Özet Metin" data-en="Summary">Özet Metin</label>
            <textarea name="ozet_tr" class="form-control" rows="2" placeholder="Haber kartında görünecek kısa özet..."></textarea>
        </div>

        <div class="form-group">
            <label data-tr="Detaylı İçerik" data-en="Full Content">Detaylı İçerik</label>
            <textarea name="icerik_tr" class="form-control" rows="4" placeholder="Haberin tam metni..."></textarea>
        </div>

        <button type="submit" class="btn btn-primary" data-tr="Haberi Yayınla" data-en="Publish News">Haberi Yayınla</button>
    </form>
</div>

<!-- Mevcut Haberler Grid -->
<h3 style="margin-bottom:1rem;" data-tr="Yayınlanan Haberler" data-en="Published News">Yayınlanan Haberler</h3>
<% if (haberler && haberler.length > 0) { %>
    <div class="grid-container">
        <% haberler.forEach(function(h) { %>
            <div class="card">
                <% if (h.resim) { %>
                    <img src="<%= h.resim %>" alt="<%= h.baslik_tr %>" style="width:100%; height:160px; object-fit:cover; border-radius:var(--radius-md); margin-bottom:1rem;">
                <% } %>
                <span style="font-size:0.8rem; color:var(--text-muted);"><%= h.tarih || '' %></span>
                <h4 style="color:var(--ak-kirmizi); margin:0.25rem 0 0.5rem;"><%= h.baslik_tr %></h4>
                <p style="color:var(--text-secondary); font-size:0.9rem; margin-bottom:1rem;"><%= h.ozet_tr || h.icerik_tr %></p>
                <form action="/panel/haberler/sil/<%= h.id %>" method="POST" onsubmit="return confirm('Bu haberi silmek istediğinize emin misiniz?');">
                    <button type="submit" class="btn btn-danger btn-sm" style="width:100%;" data-tr="Haberi Sil" data-en="Delete News">Haberi Sil</button>
                </form>
            </div>
        <% }); %>
    </div>
<% } else { %>
    <div class="card" style="text-align:center; color:var(--text-muted);" data-tr="Henüz haber eklemediniz." data-en="No news added yet.">Henüz haber eklemediniz.</div>
<% } %>

<%- include('layout_alt') %>
